@startuml
!pragma layout smetana
skinparam defaultFontName Arial
skinparam shadowing false
skinparam backgroundColor white
top to bottom direction
node "Customer device" as Client {
artifact "Browser / installed PWA" as Browser
}
node "Local development (verified target)" as Local {
node "Docker Compose" {
artifact "Next.js :3000" as LW
artifact "NestJS :3001" as LA
database "PostgreSQL :5432" as LD
storage "postgres_data volume" as LV
}
LW --> LA : internal HTTP
LA --> LD : internal TCP
LD --> LV
}
node "GitHub Actions CI" as CI {
artifact "Lint / unit / integration / E2E / build" as Jobs
artifact "Docker build and push SHA" as Build
}
cloud "GHCR registry" as Registry
node "Production VPS (configured, not yet provisioned)" as Prod {
artifact "Caddy :80/:443" as TLS
artifact "Next.js web :3000" as Web
artifact "NestJS API :3001\n/health + stdout logs" as API
database "PostgreSQL :5432\nprivate network only" as DB
storage "persistent volume + backup" as Volume
artifact "Mock payment module" as Pay
artifact "Environment secrets\nJWT_SECRET / DATABASE_URL" as Secrets
TLS --> Web : internal HTTP
TLS --> API : /backend/* internal HTTP
Web --> API : /api/* internal HTTP
API --> DB : internal TCP
DB --> Volume
API --> Pay
Secrets ..> API
}
Browser --> LW : local HTTP :3000
Browser --> TLS : planned HTTPS :443
Jobs --> Build
Build --> Registry : push image:SHA over HTTPS
Registry --> Prod : pull image:SHA over HTTPS
CI --> Prod : SSH :22 + secret; migrate; smoke; rollback
note bottom of Prod
This is the prepared production topology, not evidence
of a live deployment. Replace with actual host/domain
and verify URLs before A2 Task 5.4 acceptance.
end note

@enduml
